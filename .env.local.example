# Local: Docker Compose Postgres (postgres:16-alpine on port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production: hosted Supabase Postgres connection string (pooler or direct)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

NEXT_PUBLIC_IS_MAINNET=
NEXT_PUBLIC_NETWORK=testnet

# Legacy xUDT experiments (not used by A1 membership)
NEXT_PUBLIC_XUDT_CODE_HASH=
NEXT_PUBLIC_HASH_TYPE=

# Membership Type Script (A1) — see docs/MEMBERSHIP_DEPLOY.md
# codeHash: pnpm membership:code-hash (after contracts-rs make build)
NEXT_PUBLIC_MEMBERSHIP_CODE_HASH=
NEXT_PUBLIC_MEMBERSHIP_HASH_TYPE=data1
NEXT_PUBLIC_MEMBERSHIP_DEP_TX_HASH=
NEXT_PUBLIC_MEMBERSHIP_DEP_INDEX=0
NEXT_PUBLIC_MEMBERSHIP_CAPACITY_CKB=200
